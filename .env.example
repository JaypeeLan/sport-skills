# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Curriculum and lesson generation — console.groq.com
GROQ_API_KEY=

# Optional. Resolves each lesson to a real coaching video.
# Without it, lessons fall back to a YouTube search link.
# console.cloud.google.com → enable "YouTube Data API v3" → create an API key
YOUTUBE_API_KEY=
