{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: the main branch. Staging: `--env staging`, from the staging branch.
  "name": "sportpath-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "routes": [
    { "pattern": "sportpath.app", "custom_domain": true },
    { "pattern": "www.sportpath.app", "custom_domain": true }
  ],
  // Public values only. Secrets would go in with `wrangler secret put`.
  "vars": {
    "APP_ENV": "production",
    "API_URL": "https://api.sportpath.app/v1",
    "GOOGLE_CLIENT_ID": "399820343385-qeeap1bt3ei0lmiu0m7pp66aulbno0n1.apps.googleusercontent.com"
  },
  "env": {
    "staging": {
      "name": "sportpath-web-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "staging.sportpath.app", "custom_domain": true }],
      "vars": {
        "APP_ENV": "staging",
        "API_URL": "https://api-staging.sportpath.app/v1",
        "GOOGLE_CLIENT_ID": "399820343385-qeeap1bt3ei0lmiu0m7pp66aulbno0n1.apps.googleusercontent.com"
      }
    }
  }
}
